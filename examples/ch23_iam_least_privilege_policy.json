{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadFeatures",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::northlake-sqm-data",
        "arn:aws:s3:::northlake-sqm-data/features/*"
      ]
    },
    {
      "Sid": "WriteModelsEncrypted",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource":
        "arn:aws:s3:::northlake-sqm-models/*",
      "Condition": {
        "StringEquals": {
          "s3:x-amz-server-side-encryption": "aws:kms"
        }
      }
    }
  ]
}
