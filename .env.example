# .env.example  (copy to .env and fill in)
# Chapter 2.3 defines these; .env itself is never committed.
SQM_ENV=dev
LOG_LEVEL=INFO
ANTHROPIC_API_KEY=
HANA_HOST=hana.northlake.internal
HANA_USER=sqm_readonly
HANA_PASSWORD=
DATABASE_URL=postgresql+psycopg://sqm@localhost:5432/sqm_analytics

# Chapter 2.3 — bucket names carried on Settings
DATA_BUCKET=northlake-sqm-data
MODEL_BUCKET=northlake-sqm-models

# Chapter 22.8 — "playback" replays recorded responses so CI
# never makes a live call.
SQM_LLM_MODE=live

# Chapter 23 — read directly from the environment
AWS_REGION=us-gov-west-1
NL_ENCLAVE_REGION=us-gov-west-1
TRIAGE_QUEUE_URL=
